{
  "id": null,
  "uid": "tele-proxy-usage",
  "title": "Tele Proxy \u00b7 Usage and spend coverage",
  "description": "Provisioned operational telemetry. The durable ledger is authoritative for accounting; Prometheus is not billing. No notification delivery is enabled.",
  "tags": [
    "tele-proxy",
    "canary"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
