      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Authoritative usage / multi-basis costs",
      "type": "link",
      "url": "http://127.0.0.1:20280/dashboard/usage",
      "targetBlank": true
    },
    {
      "title": "Prometheus alerts / runbook annotations",
      "type": "link",
      "url": "http://127.0.0.1:20900/alerts",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Accounting authority and spend coverage",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "[Open the authenticated gateway usage ledger](http://127.0.0.1:20280/dashboard/usage). `GET /api/usage/ledger` exposes known/unknown usage and cost coverage, currency totals in **Micros** across **reported**, **reconciled**, **metered**, **reference**, **subscription**, and **local** bases, and fixed fees. Divide Micros by 1,000,000 only within the same currency; never sum currencies or different bases. Subscription fixed fees are period costs, not per-request charges. Reference value is not cash spend or guaranteed savings. Grafana intentionally does not scrape the admin API or derive billing from counters. Project attribution and per-combo token/cost breakdowns live in the ledger; those labels are not exported."
      }
    },
    {
      "id": 2,
      "title": "Logical requests by combo / outcome",
      "description": "Finalized logical requests, once per request. In-flight requests are not finalized yet.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (combo,outcome) (rate(nine_router_requests_total{environment=~\"$environment\",job=\"tele-proxy-canary\"}[5m]))",
          "legendFormat": "{{combo}} \u00b7 {{outcome}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Finalized upstream attempts by provider",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,outcome) (rate(nine_router_attempts_total{environment=~\"$environment\",job=\"tele-proxy-canary\"}[5m]))",
          "legendFormat": "{{provider}} \u00b7 {{outcome}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
