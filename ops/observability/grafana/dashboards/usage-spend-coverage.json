        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Unknown usage fraction of finalized attempts",
      "description": "One unknown increment per finalized attempt lacking complete input/output usage. No traffic is undefined, not proof of complete usage. This is operational window coverage; durable coverage is in the ledger.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (environment) (rate(nine_router_usage_unknown_total{environment=~\"$environment\",job=\"tele-proxy-canary\"}[15m])) or on (environment) (0 * sum by (environment) (rate(nine_router_attempts_total{environment=~\"$environment\",job=\"tele-proxy-canary\"}[15m])))) / sum by (environment) (rate(nine_router_attempts_total{environment=~\"$environment\",job=\"tele-proxy-canary\"}[15m])))",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
