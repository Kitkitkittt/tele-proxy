  "panels": [
    {
      "id": 1,
      "title": "Streaming measurement boundaries",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "First content is a meaningful model content/tool delta, **not response headers or empty SSE keepalives**. Request duration ends on terminal completion/cancellation/failure. Upstream first content groups by provider; client first content groups by combo. They are different populations: subtracting their quantiles does **not** measure gateway overhead. No gateway-only overhead or per-call output-token-rate metric exists; use the deterministic benchmark and ledger timings for those questions."
      }
    },
    {
      "id": 2,
      "title": "End-to-end logical request duration \u00b7 p50",
      "description": "Histogram quantile over five minutes; +Inf samples beyond 600 seconds can clamp the quantile to the highest finite bucket. No observations means no latency estimate.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, combo) (rate(nine_router_request_duration_seconds_bucket{environment=~\"$environment\",job=\"tele-proxy-canary\"}[5m])))",
          "legendFormat": "{{combo}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
