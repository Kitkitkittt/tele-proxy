  "panels": [
    {
      "id": 1,
      "title": "Infrastructure scope and notification posture",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Alerts are evaluated in Prometheus and shown below; **notification delivery is disabled**. Host CPU/RAM come from read-only `/proc` and `/sys`; gateway process CPU/RSS/event-loop metrics are process-specific, not cgroup utilization. `/storage` is the isolated canary data volume and reports its **backing filesystem** capacity, not a per-volume quota or capacity of every backend volume. Process start-time changes reveal observed process restarts, but multiple restarts between scrapes count once; inspect container state for container restart counts. Collector counter spelling supports OTel variants; runtime series must be checked against the pinned Alloy."
      }
    },
    {
      "id": 2,
      "title": "Scrape target availability",
      "description": "1 means metrics endpoint scraped. It does not assert all storage or remote exports are healthy.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{environment=~\"$environment\"}",
          "legendFormat": "{{job}} \u00b7 {{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "spanNulls": false
