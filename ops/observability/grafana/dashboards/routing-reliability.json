  "panels": [
    {
      "id": 1,
      "title": "Reliability scope",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Requests are finalized once; attempts represent observed dispatches. Success rate is an observed outcome, **not an active provider availability probe**. The 5xx panel counts HTTP 500–599 observed on instrumented upstream responses, not network failures, native-managed transports, or client-facing status codes. Missing data is unknown, not zero. Confirmed empty streams cover only a strict subset of client-facing OpenAI Chat SSE; all other streams are unknown. Alert thresholds are initial canary guardrails, not an approved production SLO."
      }
    },
    {
      "id": 2,
      "title": "Successful logical request fraction",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (environment) (rate(nine_router_requests_total{environment=~\"$environment\",job=\"tele-proxy-canary\",outcome=\"success\"}[5m])) or on (environment) (0 * sum by (environment) (rate(nine_router_requests_total{environment=~\"$environment\",job=\"tele-proxy-canary\"}[5m])))) / sum by (environment) (rate(nine_router_requests_total{environment=~\"$environment\",job=\"tele-proxy-canary\"}[5m])))",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
