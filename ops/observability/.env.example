# Documentation only. Do not copy empty values into a deployment.
# Generate unique local values: python3 bootstrap.py --image repository@sha256:<64 hex>
# .env and secrets/ are ignored. Never post `docker compose config` expanded output.
TELE_PROXY_IMAGE=
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
CANARY_JWT_SECRET=
CANARY_ADMIN_PASSWORD=
CANARY_API_KEY_SECRET=
CANARY_MACHINE_ID_SALT=
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_S3_ACCESS_KEY=
LF_S3_SECRET_KEY=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_NEXTAUTH_SECRET=
LF_PUBLIC_KEY=
LF_SECRET_KEY=
LF_ADMIN_EMAIL=
LF_ADMIN_PASSWORD=
# Full Basic header derived from LF_PUBLIC_KEY:LF_SECRET_KEY, not a second credential.
LANGFUSE_OTLP_AUTH=
